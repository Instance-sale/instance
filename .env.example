# ==============================================================================
# Instance - Environment Configuration Template
# Copy this file to '.env' and fill in your values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Default for local development & Docker Compose:
# - DATABASE_URL: Pooled database connection string used by the app.
# - DIRECT_URL: Direct non-pooled connection string used by Prisma for migrations.
#
# Cloud PostgreSQL (Neon, Supabase, AWS RDS):
# - Replace both with your pooled and direct connection strings from your cloud provider:
#   DATABASE_URL="postgresql://user:password@ep-pooler.region.neon.tech/neondb?sslmode=require"
#   DIRECT_URL="postgresql://user:password@ep-direct.region.neon.tech/neondb?sslmode=require"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instance?sslmode=disable
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/instance?sslmode=disable

# ------------------------------------------------------------------------------
# 2. App URLs
# ------------------------------------------------------------------------------
# Local Development:
# - NEXT_PUBLIC_APP_URL: Frontend Next.js application URL (default: http://localhost:3000)
# - NEXT_PUBLIC_API_URL: Backend NestJS API URL (default: http://localhost:4000)
#
# Production:
# - Replace with your live public domains (e.g. https://app.yourdomain.com and https://api.yourdomain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 3. Environment Mode
# ------------------------------------------------------------------------------
# Use "development" locally; set to "production" when deploying live.
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 4. NextAuth (Authentication Secret)
# ------------------------------------------------------------------------------
# Secret key used to encrypt session cookies and JWT tokens.
# How to generate (choose one):
# - Terminal: run `openssl rand -hex 32`
# - Online: visit https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=generate-32-char-random-hex-secret

# ------------------------------------------------------------------------------
# 5. Google OAuth (Optional - for Google Login)
# ------------------------------------------------------------------------------
# How to get your Google credentials:
# 1. Visit Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create a project and configure the OAuth consent screen.
# 3. Create Credentials -> OAuth Client ID -> Application type: "Web application".
# 4. Set Authorized JavaScript origins:
#    - Local: http://localhost:3000
#    - Production: https://yourdomain.com
# 5. Set Authorized redirect URIs:
#    - Local: http://localhost:3000/api/auth/callback/google
#    - Production: https://yourdomain.com/api/auth/callback/google
# 6. Copy your Client ID and Client Secret below:
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 6. Instagram & Meta App (Core Automation & Webhooks)
# ------------------------------------------------------------------------------
# How to get your Meta credentials:
# 1. Visit Meta for Developers: https://developers.facebook.com -> My Apps -> Create App.
# 2. Select "Other" -> Type: "Business" (or set up Instagram Graph API).
# 3. Add products: "Instagram" (Instagram API with Instagram Login) and "Webhooks".
# 4. App ID & App Secret: find under App Settings -> Basic.
# 5. META_WEBHOOK_VERIFY_TOKEN: any secret string you choose (must match what you enter in Meta Webhooks dashboard).
# 6. INSTAGRAM_REDIRECT_URI:
#    - Local development: your ngrok/tunnel URL or http://localhost:3000/api/instagram/callback
#    - Production: https://yourdomain.com/api/instagram/callback
#    - Remember to add this exact redirect URI under Meta App -> Instagram -> Valid OAuth Redirect URIs.
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
META_WEBHOOK_VERIFY_TOKEN=your-custom-verify-token
INSTAGRAM_BASE_URL=https://graph.instagram.com/v24.0
INSTAGRAM_GRAPH_API_BASE=https://graph.facebook.com/v24.0
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# ------------------------------------------------------------------------------
# 7. Cloudflare R2 Storage (S3-Compatible Media Storage)
# ------------------------------------------------------------------------------
# How to get your Cloudflare R2 credentials:
# 1. Visit Cloudflare Dashboard: https://dash.cloudflare.com -> R2 Object Storage.
# 2. Create a bucket (e.g. "instance-media").
# 3. Click "Manage R2 API Tokens" -> Create API Token with Object Read & Write permissions.
# 4. Copy Account ID, Access Key ID, and Secret Access Key.
# 5. In your bucket Settings -> Public Access: enable Public R2.dev URL or connect a custom domain.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=instance-media
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ------------------------------------------------------------------------------
# 8. BullMQ and Redis (Async Job Queue & Rate Limiter)
# ------------------------------------------------------------------------------
# - Local development & Docker Compose default: redis://localhost:6379
# - Production: Use a managed Redis provider (Upstash, Redis Cloud, Railway, AWS ElastiCache)
#   Example: rediss://default:password@your-redis-host:6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 9. Email (SMTP / Nodemailer for Magic Links & Notifications)
# ------------------------------------------------------------------------------
# Used for passwordless magic link logins and system notifications.
# - For Gmail: host: smtp.gmail.com, port: 587, and use an App Password (https://myaccount.google.com/apppasswords).
# - For custom domain / transactional email (Resend, SendGrid, Amazon SES, Postmark): enter your SMTP host and credentials.
# - EMAIL_FROM: if you have a custom domain email use noreply@yourdomain.com; if not, use your personal email address.
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your@email.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# ------------------------------------------------------------------------------
# 10. Cron & Automation Task Security
# ------------------------------------------------------------------------------
# Secret key used to authorize scheduled background cron triggers.
# How to generate (choose one):
# - Terminal: run `openssl rand -hex 32`
# - Online: visit https://generate-secret.vercel.app/32
CRON_SECRET=generate-32-char-random-hex-secret

# ------------------------------------------------------------------------------
# 11. Meta Instagram Rate Limits & Pacing Controls
# ------------------------------------------------------------------------------
# Configures token-bucket rate limits and pacing intervals matching official Meta specs.
# All values have production defaults. You can expand them here as your Meta tier increases.
#
# Standard Send API (Text, Links, Reactions, Stickers):
# - Meta official limit: 100 to 300 calls per second per Instagram account.
# - META_SEND_RATE_LIMIT_PER_SEC: Max messages allowed per second (default: 100, expand up to 300).
META_SEND_RATE_LIMIT_PER_SEC=100

# Send API with Audio or Video Attachments:
# - Meta official limit: strictly capped at 10 calls per second per Instagram account.
# - META_MEDIA_RATE_LIMIT_PER_SEC: Max audio/video messages per second (default: 10).
META_MEDIA_RATE_LIMIT_PER_SEC=10

# Comment-to-DM Private Replies API (Comments on Posts & Reels):
# - Meta official limit: strictly 750 calls per hour per Instagram Professional account.
# - META_PRIVATE_REPLY_RATE_LIMIT_PER_HOUR: Max private replies to comments per hour (default: 750).
META_PRIVATE_REPLY_RATE_LIMIT_PER_HOUR=750

# Comment-to-DM on Live Stream Comments:
# - Meta official limit: 100 calls per second per Instagram Professional account.
# - META_LIVE_COMMENT_RATE_LIMIT_PER_SEC: Max private replies to Live comments per second (default: 100).
META_LIVE_COMMENT_RATE_LIMIT_PER_SEC=100

# Single-Thread / Recipient Pacing:
# - Meta warning: "Your app may be rate limited if too many messages are sent to a single thread."
# - META_THREAD_PACING_MIN_INTERVAL_SEC: Min seconds between messages sent to the SAME user/thread (default: 1.0).
META_THREAD_PACING_MIN_INTERVAL_SEC=1.0

# Public Comment Replies (Replies directly under a post comment):
# - Instagram spam prevention safety limit for public comment replies (default: 60 per hour).
META_COMMENT_REPLY_RATE_LIMIT_PER_HOUR=60

# Conversations API (Reading and managing conversation threads):
# - Meta official limit: strictly 2 calls per second per Instagram account.
META_CONVERSATION_RATE_LIMIT_PER_SEC=2
