{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Instance",
  "theme": "mint",
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "customCSS": "/custom.css",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1D4ED8"
  },
  "favicon": {
    "light": "/images/web-app-manifest-192x192.webp",
    "dark": "/favicon.svg"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/Instance-sale/instance",
        "label": "Github"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open App",
      "href": "https://instance.sale"
    }
  },
  "banner": {
    "content": "Instance: The open-source Instagram sales CRM and automation platform",
    "dismissible": true,
    "type": "info"
  },
  "search": {
    "prompt": "Search for Automations, Qualification, Prompts, APIs..."
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://instance.sale",
      "github": "https://github.com/Instance-sale/instance"
    }
  },
  "navigation": {
    "pages": [
      "overview",
      "installation",
      "docker",
      "instagram-setup",
      "features",
      "safety",
      "deployment"
    ]
  },
  "description": "Instance is an AI sales CRM that turns your Instagram into a 24/7 sales pipeline. Let AI handle your DMs, qualify leads, and close deals on autopilot",
  "logo": {
    "light": "/images/web-app-manifest-192x192.webp",
    "dark": "/favicon.svg"
  },
  "integrations": {
    "ga4": {
      "measurementId": "G-N0BD0ZVNLD"
    }
  },
  "seo": {
    "metatags": {
      "description": "Documentation for Instance OSS: the open-source Instagram automation and sales CRM engine by Instance.",
      "keywords": "instance, open source, instagram automation, sales crm, manychat alternative, instagram dm automation",
      "og:site_name": "Instance",
      "twitter:card": "summary_large_image",
      "og:image": "https://www.instance.sale/web-app-manifest-192x192.png"
    },
    "organization": {
      "id": "https://instance.sale/#organization",
      "name": "Instance",
      "legalName": "Instance",
      "url": "https://instance.sale",
      "logo": "https://www.instance.sale/web-app-manifest-192x192.png",
      "sameAs": [
        "https://github.com/Instance-sale/instance"
      ]
    },
    "indexing": "all"
  },
  "thumbnails": {
    "background": "/images/web-app-manifest-192x192.webp"
  }
}