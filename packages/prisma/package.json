{
    "name": "@instance/db",
    "version": "0.1.0",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "db:generate": "prisma generate --schema=./schema.prisma",
        "db:push": "prisma db push --schema=./schema.prisma",
        "db:migrate": "prisma migrate dev --schema=./schema.prisma",
        "db:deploy": "prisma migrate deploy --schema=./schema.prisma",
        "build": "prisma generate --schema=./schema.prisma && tsc -p tsconfig.json"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.4.2",
        "@prisma/client": "^7.4.2",
        "@prisma/client-runtime-utils": "^7.4.2",
        "dotenv": "^17.3.1",
        "pg": "^8.20.0",
        "prisma": "^7.4.2"
    },
    "devDependencies": {
        "@types/node": "^20.19.37",
        "@types/pg": "^8.18.0",
        "typescript": "^5.9.3"
    }
}